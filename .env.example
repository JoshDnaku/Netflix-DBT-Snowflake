# This project uses KEY-PAIR authentication for dbt -> Snowflake, so there is
# no password to store. Connection details live in ~/.dbt/profiles.yml
# (git-ignored), which points at a local private key.
#
# This file is kept only as a reference for the non-secret connection values.
# Copy to .env if you want to drive profiles.yml via env_var() instead.

# Snowflake ORG-ACCOUNT identifier (JWT form), e.g. ABCDORG-XY12345
# Find with: SELECT CURRENT_ORGANIZATION_NAME(), CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT=YOUR_ORG-YOUR_ACCOUNT

SNOWFLAKE_USER=dbt
SNOWFLAKE_ROLE=TRANSFORM
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=MOVIELENS
SNOWFLAKE_SCHEMA=DEV

# Absolute path to the PKCS#8 private key (NEVER commit the key itself)
SNOWFLAKE_PRIVATE_KEY_PATH=C:/Users/<you>/.dbt/keys/dbt_key.p8
